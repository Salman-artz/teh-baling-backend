# Database connection string (PostgreSQL: Supabase / Neon / Neon Serverless / Railway)
DATABASE_URL=postgresql://postgres:password@your-db-host:5432/postgres?sslmode=require

# JWT Auth Secrets (min 32 chars)
JWT_SECRET=supersecretjwtkeytehbalingmin32charslong
JWT_REFRESH_SECRET=supersecretjwtrefreshkeytehbalingmin32charslong

# Allowed Frontend Origins (separated by comma)
CORS_ORIGIN=https://teh-baling-frontend.vercel.app,http://localhost:3000

# Port & Node Environment
PORT=3001
NODE_ENV=production
